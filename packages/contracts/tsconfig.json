{
    "compilerOptions": {
        "target": "ES2023",
        "module": "preserve",
        "moduleResolution": "bundler",
        "lib": ["ES2023"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*", "test/**/*"]
}
