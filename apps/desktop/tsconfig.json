{
    "compilerOptions": {
        "target": "ES2023",
        "module": "preserve",
        "moduleResolution": "bundler",
        "lib": ["ES2023"],
        "types": ["node"],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "strict": true,
        "noImplicitAny": true,
        "noEmit": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*", "test/**/*", "*.ts", "*.mts"]
}
